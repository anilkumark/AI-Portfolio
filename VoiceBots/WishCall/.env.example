# Copy this file to .env and fill in what you have.
# Anything left empty runs in simulate mode: no real calls, no money spent.

# Sarvam AI: cloned voice (text-to-speech) and speech-to-text
SARVAM_API_KEY=
SARVAM_VOICE_ID=

# Plivo: outbound phone calls
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Number calls come from, e.g. +918012345678
PLIVO_FROM_NUMBER=

# Google AI Studio: Gemini key for AI replies when people talk back
GEMINI_API_KEY=

# Public URL Plivo can reach for call callbacks, from cloudflared, e.g.
#   cloudflared tunnel --url http://localhost:8000   ->   https://xxxx.trycloudflare.com
# Empty = simulate.
PUBLIC_BASE_URL=

# Optional: put the data folder somewhere else (default: ./data)
# WISHCALL_DATA=
